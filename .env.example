# Server Configuration
PORT=8080
MAX_UPLOAD_SIZE_MB=32
MAX_DECOMPRESSED_SIZE_MB=150
MAX_CONCURRENT_EXTRACTIONS=16
EXTRACTION_TIMEOUT_SEC=60

# Microsoft Azure AI Vision Configuration (Solutioning & Architecture Insights)
ENABLE_AI_VISION=true
AZURE_VISION_ENDPOINT=https://<your-resource-name>.services.ai.azure.com
AZURE_VISION_KEY=your_azure_vision_api_key_here
VISION_CONCURRENCY=4
VISION_TIMEOUT_SEC=15

# Static Barrier Header / API Protection
# Proteksi endpoint REST API (/api/v1/extract) dengan Header: Authorization: Bearer <token> atau X-API-Key: <token>
API_BEARER_TOKEN=your_secure_api_barrier_token_here

